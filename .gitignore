# Local credentials; retain the credential-free configuration example.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json

# Python environments, bytecode and downloaded toolchains/caches.
.venv/
venv/
__pycache__/
*.py[cod]
.cache/
.cargo/
.rustup/
.pytest_cache/

# Downloaded SEC data: commit only the small reference questions and data guide.
/data/*
!/data/README.md
!/data/questions.jsonl
*.parquet

# Rebuildable retrieval databases and complete local generation/audit records.
/lume/*/db/
/lume/*/runtime/db/
/lume/*/q-a.jsonl
*.log
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Downloaded native dependency sources, built binaries and build outputs.
/lume/*/src/bin/
/lume/*/src/native/vendor/
/lume/*/runtime/src/native/vendor/
target/
node_modules/
build/
dist/
_site/

# Judge operational artifacts; compact final-results JSONL remains tracked.
/judge/*.audit.jsonl
/judge/*.state.json
/judge/*.lock
/judge/validation/*.audit.jsonl
/judge/validation/*.state.json
/judge/validation/*.lock

# Retain final, sanitized evidence; keep recovery probes and campaign state local.
/judge/validation/semantic-hybrid-*.json
!/judge/validation/semantic-hybrid-final-validation.json
/judge/validation/six-methods/*
!/judge/validation/six-methods/README.md
!/judge/validation/six-methods/final-report.json
!/judge/validation/six-methods/model-pricing.json
!/judge/validation/six-methods/run.py
!/judge/validation/six-methods/verify.py

# Editor / OS local files.
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Generated website data is rebuilt from compact exports on every build.
/website/public/data/
/website/coverage/
/website/test-results/
*.tsbuildinfo
